# AgentCanvas runs entirely on a mock LLM by default, so no keys are required to
# develop, test, build, or run the demo. These variables only matter if you wire
# in a real model provider (see src/engine/llm.ts).

# Which LLM to use: "mock" (default, deterministic) or "openai".
AGENTCANVAS_LLM=mock

# Only read when AGENTCANVAS_LLM=openai. Never commit a real key.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
